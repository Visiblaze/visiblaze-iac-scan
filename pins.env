# Pinned artefacts for the Visiblaze iac-scan action.
#
# ── Why this file exists rather than version strings in action.yml ──
#
# The action downloads and EXECUTES two binaries on a customer's runner, next to their source and
# whatever credentials that job holds. We are the security vendor in that transaction, so "fetch
# the latest release" is not available to us: it means whatever appears at a URL we do not control
# becomes code we told a customer to run. A pinned version plus a committed digest means a
# substituted artefact fails the check instead of running.
#
# Trivy is pinned for the SAME reason and more strictly, because unlike our own scanner it is a
# third-party binary from a URL we do not own at all.

SCANNER_BASE_URL=https://github.com/Visiblaze/visiblaze-iac-scan/releases/download

# Written by release-scanner.yml when it publishes to Visiblaze/visiblaze-iac-scan, never by hand.
# The digests are of visiblaze-iac-bundle_<version>_linux_<arch>.tar.gz: the scanner, the pinned
# Trivy binary and its Rego checks in one archive. Empty means no release has been pinned, and the
# action refuses to run rather than fetch something it cannot verify.
SCANNER_VERSION=v0.1.4
SCANNER_SHA256_LINUX_AMD64=620200299e664aa40bbf1c393b6aa676ddd04c2acc38609f01d1a7f7a77e7e3f
SCANNER_SHA256_LINUX_ARM64=99a7a5e8a26cf7db3360e2b26c7ac82219c7152724c4e0ad3776b198a9c4894c

# ── Release signing ──
#
# Every bundle in a release carries a Sigstore bundle (<archive>.sigstore.json) signed by the
# Visiblaze release workflow. The action requires it and verifies it against this identity: only
# the refs the release workflow may publish from (RELEASE_REFS in release-scanner.yml). Single-
# quoted because ( and | are shell syntax. Must equal the SAST action's value.
SCANNER_SIGNED=true
SCANNER_CERT_IDENTITY_REGEXP='^https://github[.]com/Visiblaze/visiblaze-IQ-Backend/[.]github/workflows/release-scanner[.]yml@refs/heads/(main|dev)$'
SCANNER_CERT_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Cosign, pinned by the digests sigstore publishes in cosign_checksums.txt.
COSIGN_VERSION=v3.1.3
COSIGN_URL_LINUX_AMD64=https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-amd64
COSIGN_SHA256_LINUX_AMD64=4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71
COSIGN_URL_LINUX_ARM64=https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-arm64
COSIGN_SHA256_LINUX_ARM64=c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a

# Trivy, and the Rego checks it evaluates.
#
# The checks travel WITH the release rather than being fetched from a registry at scan time, for
# the same reason the platform-side scanner ships them in its Lambda layer: a scan that depends on
# a registry is a scan that fails when the registry does, on someone else's schedule.
# Recorded for provenance, not for verification: Trivy and the checks are INSIDE the release
# tarball above, so SCANNER_SHA256_* already covers them. One artefact, one digest, one URL we
# control. A separate digest here would be a second thing to keep in step and a second way to be
# quietly wrong.
TRIVY_VERSION=0.70.0
CHECKS_VERSION=sha256:b591e9190cff4aa4e385b1a25bccfd9ecf178d3c77fd194e1410b7ce7e1df058

# The ingest this action is allowed to post to.
#
# An allowlist, not a default: an action that will post to any URL its caller names is a data
# exfiltration primitive wearing a security tool's clothes.
#
# The scan-ingest API serves POST /v1/code/iac/findings (GitHub OIDC, audience
# visiblaze-iac-findings). The same origin the SAST action allows. Space-separated, quoted.
ALLOWED_API_ORIGINS="https://qwc3m6imgj.execute-api.ap-south-1.amazonaws.com"
