# Pinned artefacts for the Visiblaze iac-scan action.
#
# ── Why this file exists rather than version strings in action.yml ──
#
# The action downloads and EXECUTES two binaries on a customer's runner, next to their source and
# whatever credentials that job holds. We are the security vendor in that transaction, so "fetch
# the latest release" is not available to us: it means whatever appears at a URL we do not control
# becomes code we told a customer to run. A pinned version plus a committed digest means a
# substituted artefact fails the check instead of running.
#
# Trivy is pinned for the SAME reason and more strictly, because unlike our own scanner it is a
# third-party binary from a URL we do not own at all.

SCANNER_BASE_URL=https://github.com/Visiblaze/visiblaze-iac-scan/releases/download

# ── UNSET ON PURPOSE ──
#
# No release of visiblaze-iac exists yet, so there is no digest to commit. These are left empty
# rather than filled with a plausible-looking value: a wrong digest fails loudly, an INVENTED one
# that happens to match nothing fails identically, and a reader cannot tell the two apart. The
# action refuses to run while they are empty, which is the correct behaviour for a security tool
# whose supply chain is not yet established.
SCANNER_VERSION=
SCANNER_SHA256_LINUX_AMD64=
SCANNER_SHA256_LINUX_ARM64=

# Trivy, and the Rego checks it evaluates.
#
# The checks travel WITH the release rather than being fetched from a registry at scan time, for
# the same reason the platform-side scanner ships them in its Lambda layer: a scan that depends on
# a registry is a scan that fails when the registry does, on someone else's schedule.
# Recorded for provenance, not for verification: Trivy and the checks are INSIDE the release
# tarball above, so SCANNER_SHA256_* already covers them. One artefact, one digest, one URL we
# control. A separate digest here would be a second thing to keep in step and a second way to be
# quietly wrong.
TRIVY_VERSION=
CHECKS_VERSION=

# The ingest this action is allowed to post to.
#
# An allowlist, not a default: an action that will post to any URL its caller names is a data
# exfiltration primitive wearing a security tool's clothes.
#
# ── EMPTY, and that is the blocker ──
#
# There is no ingest route for infrastructure FINDINGS. The only IaC route the platform declares
# is POST /v1/iac-index/ingest, and that takes the identity MAP -- address to cloud id -- not
# findings. Until a findings route exists, this action scans and writes a payload and refuses to
# send one, which is why --dry-run is currently the only mode that completes.
ALLOWED_API_ORIGINS=""
